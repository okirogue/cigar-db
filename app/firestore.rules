rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 스캔 카운터: 본인(익명 UID) 문서만, 하루 3회까지, 카운터는 1씩만 증감
    match /scan_quota/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.count == 1
        && request.resource.data.date is string;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.date is string
        && (
          // 날짜 바뀌면 1부터
          (request.resource.data.date != resource.data.date && request.resource.data.count == 1)
          // 같은 날이면 +1(최대 3) 또는 -1(서버 붐빔으로 실패했을 때 되돌리기, 최소 0)
          || (request.resource.data.date == resource.data.date
              && (request.resource.data.count == resource.data.count + 1
                  || request.resource.data.count == resource.data.count - 1)
              && request.resource.data.count <= 3
              && request.resource.data.count >= 0)
        );
      allow delete: if false;
    }

    // 시가 DB 제안: 로그인(익명 포함)한 사용자가 새 문서만 추가. 읽기/수정/삭제는 콘솔에서만.
    match /cigar_suggestions/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.brand is string && request.resource.data.brand.size() > 0 && request.resource.data.brand.size() <= 80
        && request.resource.data.line is string && request.resource.data.line.size() <= 120
        && request.resource.data.keys().hasOnly(['uid', 'brand', 'line', 'vitola', 'country', 'strength', 'wrapper', 'note', 'created']);
      allow read, update, delete: if false;
    }

    // 제작자에게 제안/피드백: 로그인(익명 포함)한 사용자가 새 문서만 추가. 읽기/수정/삭제는 콘솔·통계에서만.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 120
        && request.resource.data.keys().hasOnly(['uid', 'text', 'contact', 'lang', 'platform', 'build', 'created']);
      allow read, update, delete: if false;
    }

    // 익명 기록 공유: 문서 id는 "<uid>_<logId>", 본인 것만 쓰기. 읽기는 로그인(익명)한 누구나(카페 평점 집계용).
    match /log_stats/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id.matches('^' + request.auth.uid + '_[0-9]+$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cigar_id is string
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'log_id', 'cigar_id', 'cigar_name', 'vitola', 'date', 'score', 'tags', 'lang', 'updated']);
      allow delete: if request.auth != null && id.matches('^' + request.auth.uid + '_[0-9]+$');
    }

    // 앱 실행 기록: 본인(익명 UID) 문서만, 플랫폼·언어·빌드·실행 날짜 목록·공유 켜짐 여부만. 다른 사람 것은 못 읽음.
    // 문서 id: 익명은 UID, 로그인 계정은 기기가 여럿이라 UID~플랫폼. 'absorbed' = 로그인하며 넘어온 이전 익명 UID 목록.
    match /installs/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || id.matches('^' + request.auth.uid + '~[a-z]{1,16}$'));
      allow create, update: if request.auth != null && (request.auth.uid == id || id.matches('^' + request.auth.uid + '~[a-z]{1,16}$'))
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.build is int
        && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 1000))
        && (!('share' in request.resource.data) || request.resource.data.share is bool)
        && (!('absorbed' in request.resource.data) || (request.resource.data.absorbed is list && request.resource.data.absorbed.size() <= 20))
        && request.resource.data.keys().hasOnly(['platform', 'lang', 'build', 'version', 'first', 'last', 'days', 'share', 'absorbed']);
      allow delete: if false;
    }

    // 운영자 전용 기기 간 동기화: 본인 UID 아래 + 구글 로그인으로 확인된 운영자 이메일일 때만.
    // 다른 사용자는 로그인 자체가 앱에서 막히고, 혹시 들어와도 여기서 거부됨.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'okirogue@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
