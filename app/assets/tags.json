oast","ko":"구운·탄 결","hint":"토스트가 아니라 그을린 느낌, 캠프파이어"},{"id":"grass","ko":"그래스","hint":"풀 베고 난 뒤 풋내"},{"id":"mineral","ko":"미네랄","hint":"돌, 분필, 짠맛"},{"id":"tea","ko":"차","hint":"홍차·녹차의 떫은 결"},{"id":"tobacco","ko":"담배","hint":"담뱃잎 그 자체의 맛, 다른 노트 없이"}]}]}